#!/usr/bin/env bash
# Kimia Ledger pre-commit: secret scan, format check, fast tests.
# Enable once per clone:  git config core.hooksPath .githooks
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not found. Install from https://github.com/gitleaks/gitleaks/releases (pinned in CI) and retry." >&2
  exit 1
fi
gitleaks protect --staged --redact --no-banner

# Build-dependent checks only once the Gradle wrapper exists (Step 3 onwards).
if [ -x ./gradlew ]; then
  ./gradlew --quiet --offline spotlessCheck test -x integrationTest 2>/dev/null \
    || ./gradlew --quiet spotlessCheck test
fi
